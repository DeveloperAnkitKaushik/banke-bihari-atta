rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Put the owner's login email(s) here. Only these accounts can edit.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['owner@example.com'];
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin()
        && (request.method == 'delete'
            || (request.resource.data.name is string && request.resource.data.sizes is list));
    }

    match /images/{id} {
      allow read: if true;
      allow write: if isAdmin()
        && (request.method == 'delete'
            || (request.resource.data.data is string && request.resource.data.data.size() < 1000000));
    }

    match /site/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
